---
interface Props { name: 'logo' | 'chat' | 'menu' | 'close' | 'arrow' | 'back' | 'play' | 'check' | 'plus' | 'chevron' | 'phone' | 'mail' | 'prev' | 'next'; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
{name === 'logo' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 28 28" fill="none" stroke="#E9A23B" stroke-width="1.5" aria-hidden="true"><circle cx="14" cy="14" r="5" /><path d="M14 2v6M14 20v6M2 14h6M20 14h6" /></svg>
)}
{name === 'chat' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.6-4.8A8.5 8.5 0 1 1 8 19.6L3 21z" /></svg>
)}
{name === 'menu' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 6h14M2 12h14" /></svg>
)}
{name === 'close' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" /></svg>
)}
{name === 'arrow' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3l6 6-6 6" /></svg>
)}
{name === 'next' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3l6 6-6 6" /></svg>
)}
{(name === 'back' || name === 'prev') && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 3L5 9l6 6" /></svg>
)}
{name === 'play' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M2.5 1l6 4-6 4z" /></svg>
)}
{name === 'check' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="#E9A23B" stroke-width="1.7" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
)}
{name === 'plus' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="#E9A23B" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M9 3v12M3 9h12" /></svg>
)}
{name === 'chevron' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
)}
{name === 'phone' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="#E9A23B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
)}
{name === 'mail' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="#E9A23B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
)}
