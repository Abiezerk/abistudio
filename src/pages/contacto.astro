---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIALS, waLink } from '../config';
---
<Base title="Contacto" description={`Cotiza tu sesión de fotografía, drone o FPV en ${SITE.city}. Respuesta en menos de 24 horas por WhatsApp o correo.`}>
  <section class="container wrap">
    <div class="info">
      <span class="eyebrow">Contacto</span>
      <h1 class="display h1" data-reveal>Hablemos de tu <em>proyecto</em></h1>
      <p class="lead">Cuéntame qué tienes en mente. Te respondo con una propuesta en menos de 24 horas.</p>
      <a href={waLink()} class="btn btn-primary wa" target="_blank" rel="noopener"><Icon name="chat" />Escríbeme por WhatsApp</a>
      <div class="quick only-mobile">
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn btn-ghost btn-sm"><Icon name="phone" size={16} />Llamar</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-ghost btn-sm"><Icon name="mail" size={16} />Correo</a>
      </div>
      <dl class="data only-desktop">
        <div><dt class="mono">Correo</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div><dt class="mono">Teléfono</dt><dd><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></dd></div>
        <div><dt class="mono">Zona</dt><dd>{SITE.zone}</dd></div>
        {SOCIALS.length > 0 && (
          <div><dt class="mono">Redes</dt><dd class="soc">{SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</dd></div>
        )}
      </dl>
    </div>

    <form class="form" action="https://api.web3forms.com/submit" method="POST" data-reveal>
      <div class="sep only-mobile"><span></span>O déjame un mensaje<span></span></div>
      <h2 class="h3 only-desktop">O déjame un mensaje</h2>
      <input type="hidden" name="access_key" value={SITE.web3formsKey} />
      <input type="hidden" name="subject" value={`Nuevo mensaje desde ${SITE.brand}`} />
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
      <label class="field">Nombre<input type="text" name="nombre" autocomplete="name" required /></label>
      <label class="field">Correo o teléfono<input type="text" name="contacto" autocomplete="email" required /></label>
      <label class="field">Servicio
        <select name="servicio">
          <option>Fotografía</option><option>Aéreo clásico</option><option>Recorrido FPV</option><option>Acción FPV</option><option>No estoy seguro</option>
        </select>
      </label>
      <label class="field">Fecha aproximada<input type="date" name="fecha" /></label>
      <label class="field full">Cuéntame del proyecto<textarea name="mensaje" rows="5" placeholder="Lugar, tipo de fotos o video, para qué lo usarás…" required></textarea></label>
      <button type="submit" class="btn btn-light full">Enviar mensaje</button>
      <p class="note full" data-status role="status">Respondo en menos de 24 horas, de lunes a sábado.</p>
    </form>

    <dl class="data only-mobile m-data">
      <div><dt class="mono">Zona</dt><dd>{SITE.zone}</dd></div>
      <div><dt class="mono">Respuesta</dt><dd>Menos de 24 h · lun a sáb</dd></div>
    </dl>
  </section>
</Base>

<style>
  .wrap { display: flex; flex-wrap: wrap; gap: 64px 96px; padding-top: 96px; padding-bottom: 120px; }
  .info { flex: 1 1 380px; display: flex; flex-direction: column; gap: 28px; }
  .info .h1 { font-size: clamp(46px, 6.4vw, 96px); }
  .info .lead { font-size: 18px; }
  .wa { align-self: flex-start; min-height: 56px; }
  .data { margin: 12px 0 0; border-top: 1px solid var(--line); }
  .data > div { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .data dd { margin: 0; text-align: right; }
  .soc { display: flex; gap: 16px; }
  .form { flex: 999 1 560px; min-width: 0; align-self: flex-start; padding: 40px; border: 1px solid #2A2D30; border-radius: 8px; background: var(--card); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .form .h3, .form .full { grid-column: 1 / -1; }
  .form .h3 { margin-bottom: 4px; }
  .note { margin: 0; font-size: 13px; color: var(--subtle); text-align: center; }

  @media (max-width: 760px) {
    .wrap { display: block; padding-top: 32px; padding-bottom: 40px; }
    .info { gap: 0; }
    .info .h1 { font-size: 46px; margin: 10px 0; }
    .info .lead { font-size: 15px; margin-bottom: 22px; }
    .wa { align-self: stretch; }
    .quick { display: grid !important; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .form { display: flex; flex-direction: column; gap: 14px; padding: 0; border: 0; background: none; margin-top: 32px; }
    .sep { display: flex !important; align-items: center; gap: 14px; margin-bottom: 8px; font-family: var(--f-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--subtle); }
    .sep span { flex: 1; height: 1px; background: #2A2D30; }
    .form .btn { min-height: 56px; }
    .m-data { display: block !important; margin-top: 32px; }
    .m-data > div { padding: 14px 0; font-size: 14px; }
  }
</style>

<script>
  // Envía el formulario sin salir de la página
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true; btn.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (data.success) { form.reset(); status.textContent = '¡Gracias! Recibí tu mensaje y te respondo muy pronto.'; status.style.color = 'var(--accent)'; }
      else throw new Error();
    } catch {
      status.textContent = 'No se pudo enviar. Escríbeme por WhatsApp y te respondo enseguida.';
    } finally { btn.disabled = false; btn.textContent = 'Enviar mensaje'; }
  });
</script>
