---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink } from '../config';
import { SERVICIOS, PASOS, PREGUNTAS } from '../data/contenido';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios',
    itemListElement: SERVICIOS.map((s, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Service', name: s.nombre, description: s.desc, areaServed: SITE.city, provider: { '@type': 'ProfessionalService', name: SITE.brand } },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: PREGUNTAS.map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })),
  },
];
---
<Base title="Servicios" description={`Fotografía, aéreo clásico, recorridos FPV y acción FPV en ${SITE.city}. Paquetes claros, entrega rápida y licencia comercial.`} schema={schema}>
  <section class="container intro">
    <span class="eyebrow">Servicios</span>
    <div class="intro-row">
      <h1 class="display h1" data-reveal>Elige cómo quieres <em>contar</em> tu historia</h1>
      <p class="lead only-desktop">{SERVICIOS.length === 4 ? 'Cuatro formas' : 'Varias formas'} de trabajar juntos. Si no sabes cuál necesitas, escríbeme y te recomiendo la mejor para tu proyecto.</p>
      <p class="lead only-mobile">Toca un servicio para ver qué incluye.</p>
    </div>
    <nav class="pills only-desktop" aria-label="Ir a un servicio">
      {SERVICIOS.map((s) => <a class="btn btn-ghost btn-sm" href={`#${s.id}`}><span class="mono" style="color:var(--accent)">{s.n}</span>{s.nombre}</a>)}
    </nav>
  </section>

  <!-- ESCRITORIO -->
  <section class="container only-desktop rows" data-stagger>
    {SERVICIOS.map((s, i) => (
      <article id={s.id} class:list={['row', { reverse: i % 2 === 1, hot: s.destacado }]}>
        <div class="media row-media">
          <Media name={s.foto} alt={`${s.nombre}: ejemplo de trabajo`} sizes="(max-width: 1200px) 55vw, 760px" label={s.video ? '' : `[Foto de ${s.nombre}]`} />
          {s.video && <video class="svc-video" data-src={s.video} data-inview muted loop playsinline preload="none" aria-hidden="true"></video>}
        </div>
        <div class="row-body">
          <div class="row-top">
            <span class="eyebrow">{s.n}</span>
            {s.destacado && <span class="badge">El más pedido</span>}
          </div>
          <h2 class="display" style="font-size:56px;line-height:1">{s.nombre}</h2>
          <p class="desc">{s.desc}</p>
          <p class="for"><strong>Ideal para:</strong> {s.para}</p>
          <ul class="incl">{s.incluye.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
          <div class="row-foot">
            {s.precio ? <div class="price">Desde <span>{s.precio}</span></div> : <span></span>}
            <div class="row-actions">
              <a href={`/portafolio/${s.linea === 'aire' ? '?linea=aire' : ''}`} class="btn btn-ghost btn-sm">Ver ejemplos</a>
              <a href={waLink(s.wa)} class="btn btn-primary btn-sm" target="_blank" rel="noopener">Cotizar</a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- MÓVIL: lista desplegable. Al abrir, la miniatura crece y los detalles quedan debajo -->
  <section class="container only-mobile acc" data-stagger>
    {SERVICIOS.map((s) => (
      <details id={`m-${s.id}`} open={s.destacado} data-svc>
        <summary>
          <span class="thumb media" style={`view-transition-name: thumb-${s.id}`}>
            <Media name={s.foto} alt={`${s.nombre}: ejemplo de trabajo`} sizes="100vw" widths={[160, 480, 800, 1200]} label={s.video ? '' : `[Foto de ${s.nombre}]`} />
            {s.video && <video class="svc-video" data-src={s.video} muted loop playsinline preload="none" aria-hidden="true"></video>}
            {s.video && <span class="mini-play accent"><Icon name="play" size={12} /></span>}
          </span>
          <span class="sum-txt" style={`view-transition-name: txt-${s.id}`}>
            <span class="sum-name">{s.nombre}{s.destacado && <span class="badge sm">Más pedido</span>}</span>
            <span class="sum-desc">{s.corto}</span>
            {s.precio && <span class="mono">Desde {s.precio}</span>}
          </span>
          <span class="chev" style={`view-transition-name: chev-${s.id}`}><Icon name="chevron" size={16} /></span>
        </summary>
        <div class="acc-body">
          {s.desc && <p class="desc-m">{s.desc}</p>}
          {s.para && <p class="for"><strong>Ideal para:</strong> {s.para}</p>}
          {s.incluye.length > 0 && <ul class="incl">{s.incluye.map((x) => <li><Icon name="check" size={14} />{x}</li>)}</ul>}
          <div class="acc-actions">
            <a href={`/portafolio/${s.linea === 'aire' ? '?linea=aire' : ''}`} class="btn btn-ghost btn-sm">Ejemplos</a>
            <a href={waLink(s.wa)} class="btn btn-primary btn-sm" target="_blank" rel="noopener">Cotizar</a>
          </div>
        </div>
      </details>
    ))}
  </section>

  <!-- PROCESO -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Cómo trabajo</span>
      <h2 class="h2 steps-title">De la idea a tu galería<span class="only-desktop">, en 4 pasos</span></h2>
      <ol class="steps" data-stagger>
        {PASOS.map((p) => <li><span class="n">{p.n}</span><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="section faq-wrap">
    <div class="container faq">
      <div class="faq-head">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 class="h2" style="margin-top:16px">Lo que me preguntan antes de contratar</h2>
      </div>
      <div class="faq-list">
        {PREGUNTAS.map((p) => (
          <details>
            <summary>{p.q}<Icon name="plus" size={16} /></summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2 class="h2" style="max-width:760px;font-size:clamp(30px,4.4vw,60px)">¿No sabes cuál elegir? Cuéntame tu idea y te recomiendo.</h2>
      <div class="actions" style="display:flex">
        <a href={waLink()} class="btn btn-primary" target="_blank" rel="noopener"><Icon name="chat" />Escríbeme por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: 96px; padding-bottom: 64px; }
  .intro-row { display: flex; flex-wrap: wrap; gap: 24px 32px; align-items: flex-end; justify-content: space-between; margin: 20px 0 48px; }
  .intro-row .h1 { max-width: 860px; font-size: clamp(42px, 7vw, 108px); }
  .pills .btn { gap: 10px; }

  .rows { display: flex; flex-direction: column; gap: 24px; padding-bottom: 40px; }
  .row { display: flex; flex-wrap: wrap; border: 1px solid #2A2D30; border-radius: 6px; overflow: hidden; background: var(--card); scroll-margin-top: 24px; }
  .row.reverse { flex-direction: row-reverse; }
  .row.hot { background: var(--accent-soft); border-color: var(--accent); }
  .row-media { flex: 999 1 560px; min-width: 0; min-height: 520px; border-radius: 0; }
  .row-media :global(img), .row-media :global(.ph), .row-media .svc-video { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .row-body { flex: 1 1 400px; padding: 48px; display: flex; flex-direction: column; gap: 20px; justify-content: center; }
  .row-top { display: flex; justify-content: space-between; align-items: center; }
  .badge { font-family: var(--f-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); }
  .badge { white-space: nowrap; }
  .badge.sm { font-size: 9px; padding: 4px 7px; }
  .desc { margin: 0; color: var(--muted); font-size: 17px; }
  .for { margin: 0; font-size: 14px; color: var(--subtle); }
  .for strong { color: var(--text); font-weight: 600; }
  .incl { margin: 4px 0 0; padding: 20px 0 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; border-top: 1px solid #2A2D30; }
  .incl li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.4; }
  .incl :global(svg) { flex: none; margin-top: 2px; }
  .row-foot { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; margin-top: 12px; }
  .price { font-size: 14px; color: var(--subtle); }
  .price span { font-family: var(--f-display); font-size: 40px; color: var(--text); }
  .row-actions { display: flex; gap: 10px; }

  .steps-title { margin: 16px 0 48px; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
  .steps li { padding: 32px 28px; border: 1px solid #2A2D30; border-radius: 6px; display: flex; flex-direction: column; gap: 14px; }
  .steps .n { font-family: var(--f-display); font-size: 56px; line-height: 1; color: var(--accent); }
  .steps h3 { margin: 0; font-size: 19px; }
  .steps p { margin: 0; color: var(--muted); font-size: 15px; }

  .faq-wrap { padding-bottom: 120px; }
  .faq { display: flex; flex-wrap: wrap; gap: 48px 80px; }
  .faq-head { flex: 1 1 320px; }
  .faq-list { flex: 999 1 560px; min-width: 0; border-top: 1px solid #2A2D30; }
  .faq details { border-bottom: 1px solid #2A2D30; }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; min-height: 76px; padding: 18px 0; font-size: 19px; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { flex: none; transition: transform .25s; }
  .faq details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq details p { margin: 0 0 24px; max-width: 640px; color: var(--muted); }

  @media (max-width: 760px) {
    .intro { padding-top: 32px; padding-bottom: 20px; }
    .intro-row { display: block; margin: 10px 0 0; }
    .intro-row .h1 { font-size: 42px; line-height: 1; margin-bottom: 10px; }

    .acc { border-top: 1px solid var(--line); padding-bottom: 16px; }
    .acc details { border-bottom: 1px solid var(--line); }
    .acc summary {
      list-style: none; cursor: pointer; padding: 16px 0;
      display: grid; grid-template-columns: 64px minmax(0, 1fr) 32px; align-items: center; gap: 14px;
    }
    .acc summary::-webkit-details-marker { display: none; }
    .thumb { width: 64px; height: 64px; border-radius: 8px; }
    .thumb :global(img), .thumb :global(.ph), .thumb .svc-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .thumb :global(.ph) { background-size: 16px 16px; }
    .acc details:not([open]) .thumb :global(.ph-label) { display: none; }
    .mini-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; transition: opacity .3s; }
    .sum-txt { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .sum-name { font-family: var(--f-display); font-size: 24px; line-height: 1.15; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
    .sum-desc { font-size: 14px; color: var(--muted); line-height: 1.35; }
    .chev { width: 32px; height: 32px; border-radius: 50%; border: 1px solid #3A3D40; display: flex; align-items: center; justify-content: center; transition: transform .25s; }

    /* Abierto: la miniatura se vuelve una imagen grande y todo lo demás baja */
    .acc details[open] summary { grid-template-columns: minmax(0, 1fr) 32px; row-gap: 16px; padding-bottom: 12px; }
    .acc details[open] .thumb { grid-column: 1 / -1; width: 100%; height: auto; aspect-ratio: 4 / 3; border-radius: 12px; }
    .acc details[open] .chev { transform: rotate(180deg); align-self: start; margin-top: 4px; }
    .acc details[open] .sum-name { font-size: 30px; }
    .acc details[open] .thumb.playing .mini-play { opacity: 0; }

    .acc-body { padding: 0 0 22px; display: flex; flex-direction: column; gap: 12px; }
    .acc details[open] .acc-body { animation: fadeUp .5s var(--ease) .1s both; }
    .desc-m { margin: 0; color: var(--muted); font-size: 15px; }
    .acc .incl { grid-template-columns: 1fr; gap: 8px; padding: 14px 0 0; border-top: 1px solid #2A2D30; margin: 0; }
    .acc .incl li { font-size: 14px; gap: 8px; }
    .acc-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px; }
    .acc-actions .btn { min-height: 52px; padding: 0 10px; }

    .steps-title { margin: 10px 0 20px; font-size: 34px; }
    .steps { grid-template-columns: 1fr 1fr; gap: 10px; }
    .steps li { padding: 16px; border-radius: 10px; gap: 6px; border-color: var(--line); }
    .steps .n { font-size: 28px; }
    .steps h3 { font-size: 15px; }
    .steps p { font-size: 13px; line-height: 1.45; }

    .faq-wrap { padding-bottom: 48px; }
    .faq { gap: 16px; }
    .faq-head .h2 { font-size: 34px; }
    .faq summary { min-height: 56px; padding: 12px 0; font-size: 15px; }
    .faq details p { font-size: 14px; margin-bottom: 16px; }
  }
  .svc-video { opacity: 0; transition: opacity .5s; }
  .svc-video.on { opacity: 1; }
  ::view-transition-group(*) { animation-duration: .45s; animation-timing-function: cubic-bezier(.2, .7, .2, 1); }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reproduce o pausa el video de un servicio
  function setVideo(v: HTMLVideoElement | null, play: boolean) {
    if (!v) return;
    if (play) {
      if (!v.src) v.src = v.dataset.src!;
      v.play().then(() => { v.classList.add('on'); v.closest('.thumb')?.classList.add('playing'); }).catch(() => {});
    } else {
      v.pause();
    }
  }

  // Móvil: al abrir un servicio, la miniatura crece con una transición suave
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-svc]'));
  items.forEach((d) => {
    const summary = d.querySelector('summary')!;
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      const opening = !d.open;
      const apply = () => {
        items.forEach((o) => { if (o !== d && o.open) { o.open = false; setVideo(o.querySelector('video'), false); } });
        d.open = opening;
      };
      const vt = (document as any).startViewTransition;
      if (vt && !reduce) {
        const t = vt.call(document, apply);
        t.finished.then(() => {
          setVideo(d.querySelector('video'), opening);
          if (opening) d.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      } else {
        apply();
        setVideo(d.querySelector('video'), opening);
      }
    });
    if (d.open && d.offsetParent) setVideo(d.querySelector('video'), true);
  });

  // Escritorio: los videos se reproducen solo cuando están en pantalla
  const io = new IntersectionObserver((entries) => entries.forEach((en) => setVideo(en.target as HTMLVideoElement, en.isIntersecting)), { threshold: 0.3 });
  document.querySelectorAll<HTMLVideoElement>('video[data-inview]').forEach((v) => io.observe(v));
</script>
