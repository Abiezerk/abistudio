---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import { SITE, waLink, WA_MSG } from '../config';
import { CASOS } from '../data/contenido';
---
<Base title="Casos de estudio" description={`Proyectos reales de fotografía, drone y FPV en ${SITE.city}: el reto de cada cliente, cómo lo resolví y el resultado.`}>
  <section class="container intro">
    <span class="eyebrow">Casos de estudio</span>
    <div class="intro-row">
      <h1 class="display h1" data-reveal>Proyectos reales, <em>resultados</em> reales</h1>
      <p class="lead">Qué necesitaba cada cliente, cómo lo resolví y qué logró con las imágenes.</p>
    </div>
  </section>

  {CASOS.length === 0 ? (
    <section class="container empty">
      <p>Estoy preparando los primeros casos. Mientras tanto, mira mi trabajo en el portafolio.</p>
      <div class="empty-actions">
        <a href="/portafolio/" class="btn btn-ghost">Ver portafolio</a>
        <a href={waLink(WA_MSG.caso)} class="btn btn-primary" target="_blank" rel="noopener">Hablemos</a>
      </div>
    </section>
  ) : (
    <section class="container cases">
      {CASOS.map((c) => (
        <article class="case">
          <header class="case-head" data-reveal>
            <div class="case-title">
              <span class="mono accent">{c.n}{c.tipo && <span class="only-mobile"> · {c.tipo}</span>}</span>
              <h2 class="display">{c.titulo}</h2>
            </div>
            <span class="mono">{[c.cliente, c.ciudad].filter(Boolean).join(' · ')}{c.tipo && <span class="only-desktop"> · {c.tipo}</span>}</span>
          </header>
          <div class:list={['case-media', { solo: c.detalles.length === 0 }]}>
            <div class="media main" data-clip>
              <Media name={c.foto} alt={`${c.titulo}${c.tipo ? ` — ${c.tipo}` : ''}`} sizes="(max-width: 760px) 100vw, 900px" />
              {c.youtube && (
                <button type="button" class="yt" data-yt={c.youtube} aria-label={`Ver video de ${c.titulo}`}>
                  <span class="play play-accent" style="color:var(--accent-ink)"><Icon name="play" size={16} /></span>
                </button>
              )}
            </div>
            {c.detalles.length > 0 && (
              <div class="side" data-stagger>
                {c.detalles.map((d, i) => <div class="media"><Media name={d} alt={`Detalle ${i + 1} de ${c.titulo}`} sizes="(max-width: 760px) 50vw, 420px" /></div>)}
              </div>
            )}
          </div>
          <div class="case-text" data-stagger>
            {c.reto && <div><span class="eyebrow">El reto</span><p>{c.reto}</p></div>}
            {c.hice && <div><span class="eyebrow">Lo que hice</span><p>{c.hice}</p></div>}
            {c.resultado && <div class="res"><span class="eyebrow">El resultado</span><p>{c.resultado}</p></div>}
          </div>
        </article>
      ))}
    </section>
  )}

  <section class="cta-band">
    <div class="container">
      <h2 class="h2" style="max-width:760px;font-size:clamp(30px,4.4vw,60px)">¿Quieres que tu proyecto sea el siguiente caso?</h2>
      <div class="actions" style="display:flex"><a href="/contacto/" class="btn btn-primary">Hablemos</a></div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: 96px; padding-bottom: 64px; }
  .intro-row { display: flex; flex-wrap: wrap; gap: 24px 32px; align-items: flex-end; justify-content: space-between; margin-top: 20px; }
  .intro-row .h1 { max-width: 900px; font-size: clamp(42px, 7vw, 108px); }
  .empty { padding-bottom: 120px; }
  .empty p { color: var(--muted); font-size: 18px; max-width: 560px; margin: 0 0 24px; }
  .empty-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cases { display: flex; flex-direction: column; gap: 120px; padding-bottom: 120px; }
  .case { display: flex; flex-direction: column; gap: 28px; }
  .case-head { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: baseline; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .case-title { display: flex; align-items: baseline; gap: 20px; }
  .case-title .display { font-size: clamp(32px, 4.4vw, 60px); line-height: 1; }
  .case-media { display: flex; flex-wrap: wrap; gap: 16px; }
  .main { flex: 999 1 640px; min-width: 0; height: 540px; }
  .solo .main { flex-basis: 100%; }
  .side { flex: 1 1 300px; display: flex; flex-direction: column; gap: 16px; }
  .side .media { flex: 1; min-height: 170px; }
  .case-media :global(img), .case-media :global(.ph), .case-media :global(iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  .yt { position: absolute; inset: 0; border: 0; background: transparent; cursor: pointer; padding: 0; }
  .case-text { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px; }
  .case-text p { margin: 10px 0 0; color: var(--muted); }
  .res p { font-family: var(--f-display); font-size: 30px; line-height: 1.15; color: var(--text); }

  @media (max-width: 760px) {
    .intro { padding-top: 32px; padding-bottom: 12px; }
    .intro-row { display: block; margin-top: 10px; }
    .intro-row .h1 { font-size: 44px; margin-bottom: 10px; }
    .empty { padding-top: 24px; padding-bottom: 56px; }
    .empty p { font-size: 16px; }
    .empty-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .cases { gap: 56px; padding-top: 24px; padding-bottom: 56px; }
    .case { gap: 14px; }
    .case-head { flex-direction: column; gap: 4px; padding-bottom: 14px; }
    .case-title { flex-direction: column; gap: 4px; }
    .case-title .display { font-size: 32px; line-height: 1.05; }
    .main { flex-basis: 100%; height: 240px; border-radius: 8px; }
    .side { flex-direction: row; flex-basis: 100%; gap: 8px; }
    .side .media { min-height: 110px; height: 110px; border-radius: 8px; }
    .case-text { grid-template-columns: 1fr; gap: 16px; margin-top: 6px; }
    .case-text p { font-size: 15px; margin-top: 4px; }
    .res { padding: 16px; border-radius: 8px; background: var(--accent-soft); border: 1px solid #3A2E1A; }
    .res p { font-size: 24px; line-height: 1.2; }
  }
</style>

<script>
  // Al tocar el botón de play, se carga el video de YouTube en su lugar
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.getAttribute('aria-label') || 'Video';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    b.parentElement!.replaceChildren(f);
  }));
</script>
